{
  "name": "guildhub-frontend",
  "private": true,
  "version": "0.0.0",
  "description": "GuildHub 前端 —— 有空間感的自由工作者／專案媒合平台",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev -p 3100",
    "start": "next start -p 3101",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "next build",
    "contract:generate": "npx -y openapi-typescript@7.13.0 http://localhost:8000/openapi.json -o src/api/contract/schema.d.ts",
    "test:integration": "vitest run --config vitest.integration.mts",
    "db:reset": "node scripts/db.mjs reset",
    "db:seed": "node scripts/db.mjs seed",
    "test:contract:internal": "CONTRACT_TARGET=internal vitest run --config vitest.contract.mts",
    "test:contract:guildhub": "node scripts/contract-guildhub.mjs",
    "realtime:stub": "tsx scripts/realtime-stub.ts"
  },
  "dependencies": {
    "@react-three/fiber": "9.7.0",
    "@react-three/rapier": "2.2.0",
    "next": "16.3.4",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "three": "0.185.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@fission-ai/openspec": "1.11.0",
    "@react-three/test-renderer": "^9.1.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.4.1",
    "@types/pg": "^8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/three": "0.185.4",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "jsdom": "30.0.1",
    "lockfile-lint": "5.0.1",
    "playwright-core": "^1.63.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.13",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "vitest": "5.0.0",
    "ws": "^8.21.3"
  }
}
