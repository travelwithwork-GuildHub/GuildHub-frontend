node_modules/
node_modules
__pycache__/
*.pyc
.venv/
.DS_Store
dist/
build/
# 環境變數。**`.env.example` 是唯一進版控的那一份**（它只有變數名稱與
# 本機預設值，沒有任何機密）。`.env*.local` 用萬用字元 ——
# `.env.production.local` 這種名字光靠 `.env.local` 一行是擋不住的。
.env
.env.local
.env*.local
coverage/
playwright-report/
test-results/

# wbs-page.sh 的產物。**產出來的東西不進版控** ——
# 一份「從 WBS.md 產出來、卻自己存在版控裡」的 HTML 會漂：
# 有人改了 WBS 但忘了重產，那一頁就開始說謊，而且沒有人會發現。
docs/wbs.html

# Next.js 的建置產物與快取。生成物不進版控，也不計入 PR 的 400 行上限。
.next/
next-env.d.ts
.turbo/
*.tsbuildinfo

# Vercel CLI 連結專案時建立的（含 projectId / orgId）。
# **不進版控** —— 它綁定一個特定的 Vercel 帳號與專案，
# 而別人 clone 之後會拿到一個指向別人專案的連結。
.vercel
.env*
tests/contract/golden/.recording/

# ui-ux-pro-max 的 `--persist` 產物。**不進版控** —— 它會變成第三套規格文件
# （視覺規則的唯一來源是 openspec/specs/）。要留就留在本機，要定案就開 spec/ PR。
design-system/
docs/arch.html

# archive 前雙模型影子審查的產物與帳本（`.github/scripts/archive-review.sh`）。**不進版控** ——
# 是試驗的量尺，結算完就刪；進了版控就會變成第二份「審查紀錄」而沒有人維護。只忽略它自己的兩個路徑。
/.local/archive-review/
/.local/archive-review.jsonl
